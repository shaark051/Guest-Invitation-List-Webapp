rules_version = '2';

// Baseline rules for Guest Ledger.
// Anyone who opens the app is silently signed in anonymously (see app.js),
// so `request.auth != null` blocks random scripts hitting the Firestore API
// directly, while keeping the app itself login-free for guests/organizers.
// This is NOT a password — see README.md "Tightening access" for how to
// restrict writes to specific people once you've shared the link.

service cloud.firestore {
  match /databases/{database}/documents {

    match /guests/{guestId} {
      allow read, write: if request.auth != null;
    }

    match /meta/{docId} {
      allow read, write: if request.auth != null;
    }

    // deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
